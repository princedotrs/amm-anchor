
action "amm_anchor_deposit_event" "svm::deploy_subgraph" {
    program_id = action.deploy_amm_anchor.program_id
    program_idl = action.deploy_amm_anchor.program_idl
    block_height = 0 // action.deploy_amm_anchor.block_height
    event {
        name = "DepositEvent"
    }
}

